# Google AI (Gemini) API Key - Free tier
# Get your key at: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Config - Free tier
# Create project at: https://console.firebase.google.com
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Quote Request (server-side, set di Vercel Project Settings — JANGAN commit nilai asli)
# Dipakai oleh api/send-quote.ts untuk kirim PDF ke Xero via Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
XERO_INBOX_EMAIL=xero.inbox.xxxxx@xerofiles.com
QUOTE_FROM_EMAIL=quote@kinaryaloka.com
